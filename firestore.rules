rules_version = '2';

// ─── Règles Firestore — Mijoté ───────────────────────────────────────────────
// Modèle de données :
//   users/{uid}/**         données privées de chaque utilisateur (recettes, méta…)
//   master/{doc}           base partagée en lecture, écriture réservée à l'admin
//   userDirectory/{uid}    fiche publique (email/avatar) pour foyer/invitations
//   publicRecipes/{pubId}  recettes (et bases) publiées, lisibles par tous les
//                          connectés ; écriture réservée à leur auteur
//
// Déploiement : `npx firebase deploy --only firestore:rules`

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helpers ──────────────────────────────────────────────────────────────
    function isSignedIn() {
      return request.auth != null;
    }
    // Email-based auth : on exige un email VÉRIFIÉ (protège le jour où une auth
    // email/mot de passe non vérifiée serait ajoutée à côté de Google).
    function hasVerifiedEmail() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }
    function email() {
      return request.auth.token.email;
    }
    function isAdmin() {
      return hasVerifiedEmail()
             && email() == 'corentin.ducloux.edifice@gmail.com';
    }

    // ── Données privées de chaque utilisateur ────────────────────────────────
    match /users/{uid}/{document=**} {
      allow read, write: if isSignedIn() && request.auth.uid == uid;
    }

    // ── Abonnements Stripe (Mijoté+) ──────────────────────────────────────────
    // Écriture RÉSERVÉE au serveur (webhook via Admin SDK, qui contourne les
    // règles) ; le client lit seulement SES propres documents (statut d'abonnement,
    // mapping client Stripe). Aucun secret Stripe n'y est stocké.
    match /customers/{uid} {
      allow read: if isSignedIn() && request.auth.uid == uid;
      allow write: if false;
      match /subscriptions/{subId} {
        allow read: if isSignedIn() && request.auth.uid == uid;
        allow write: if false;
      }
    }

    // ── Base Master partagée (écriture : admin) ──────────────────────────────
    // Lecture par DOC uniquement (`get`), jamais par requête (`list`) : la base
    // d'ingrédients enrichie (Ciqual) n'est pas énumérable/aspirable en masse. Le
    // client la charge de toute façon doc par doc (getDoc ingredients/utensils/…).
    // Email vérifié requis (relève la barre vs un simple compte scriptable).
    match /master/{doc} {
      allow get: if hasVerifiedEmail();
      allow write: if isAdmin();
    }

    // ── Annuaire utilisateurs : chacun écrit SA fiche ; lecture par connectés ─
    match /userDirectory/{uid} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && request.auth.uid == uid;
    }

    // ── Foyers (households) ───────────────────────────────────────────────────
    // Appartenance par uid (membre) ; invitation par email. Plafond « 4 places »
    // (membres actifs + invitations en attente) et propriétaire immuable appliqués
    // côté serveur. Les sous-collections (recettes, méta du foyer — Phase 2) sont
    // accessibles aux membres via un get() sur le doc parent.
    match /households/{hid} {
      function isHMember(rsc) { return isSignedIn() && request.auth.uid in rsc.data.memberUids; }
      function isHInvited(rsc) { return hasVerifiedEmail() && email() in rsc.data.invitedEmails; }
      function peopleOk(d) { return d.memberUids.size() <= 2 && d.memberUids.size() + d.invitedEmails.size() <= 2; }

      allow read: if isHMember(resource) || isHInvited(resource);

      // Création : le créateur s'inscrit owner + unique membre, sans invitation préchargée.
      allow create: if hasVerifiedEmail()
                    && request.resource.data.ownerUid == request.auth.uid
                    && request.resource.data.memberUids == [request.auth.uid]
                    && email() in request.resource.data.memberEmails
                    && request.resource.data.invitedEmails.size() == 0;

      // Mise à jour : un membre ou un invité (qui accepte) édite, MAIS owner immuable
      // et plafond de 4 places maintenu.
      allow update: if (isHMember(resource) || isHInvited(resource))
                    && request.resource.data.ownerUid == resource.data.ownerUid
                    && peopleOk(request.resource.data);

      // Dissolution : propriétaire uniquement.
      allow delete: if isSignedIn() && request.auth.uid == resource.data.ownerUid;

      // Sous-collections du foyer (recettes / meta) — accès réservé aux membres.
      match /{document=**} {
        allow read, write: if isSignedIn()
          && request.auth.uid in get(/databases/$(database)/documents/households/$(hid)).data.memberUids;
      }
    }

    // ── Recettes publiques (communauté) ───────────────────────────────────────
    // Lecture par tout utilisateur connecté (découverte). Écriture/suppression
    // réservées à l'auteur : on exige que `authorUid` soit l'uid courant ET que
    // l'identifiant du doc soit préfixé « {uid}__ » (défense en profondeur, cohérent
    // avec publicId() côté client). Les composants publiés suivent les mêmes règles.
    match /publicRecipes/{pubId} {
      function ownsDoc() {
        return hasVerifiedEmail()
               && request.auth.uid == request.resource.data.authorUid
               && pubId.split('__')[0] == request.auth.uid;
      }
      // Lecture : email vérifié requis. `get` (voir une recette publique / cloner
      // un composant par pubId) libre ; `list` (feed Découverte) borné à 120 pour
      // interdire l'aspiration de toute la collection en une requête — aligné sur
      // fetchPublicRecipes(max = 120). Une requête sans limite est refusée.
      allow get: if hasVerifiedEmail();
      allow list: if hasVerifiedEmail() && request.query.limit <= 120;
      allow create, update: if ownsDoc();
      allow delete: if hasVerifiedEmail()
                    && request.auth.uid == resource.data.authorUid;
    }
  }
}
