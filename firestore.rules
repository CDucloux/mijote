rules_version = '2';

// ─── Règles Firestore — Mijoté ───────────────────────────────────────────────
// Modèle de données :
//   users/{uid}/**         données privées de chaque utilisateur (recettes, méta…)
//   master/{doc}           base partagée en lecture, écriture réservée à l'admin
//   userDirectory/{uid}    fiche publique (email/avatar) proposée au partage
//   sharedLists/{listId}   listes de courses partagées (autorisation par email)
//
// Déploiement : `npx firebase deploy --only firestore:rules`

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helpers ──────────────────────────────────────────────────────────────
    function isSignedIn() {
      return request.auth != null;
    }
    // Email-based auth : on exige un email VÉRIFIÉ (protège le jour où une auth
    // email/mot de passe non vérifiée serait ajoutée à côté de Google).
    function hasVerifiedEmail() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }
    function email() {
      return request.auth.token.email;
    }
    function isAdmin() {
      return hasVerifiedEmail()
             && email() == 'corentin.ducloux.edifice@gmail.com';
    }

    // ── Données privées de chaque utilisateur ────────────────────────────────
    match /users/{uid}/{document=**} {
      allow read, write: if isSignedIn() && request.auth.uid == uid;
    }

    // ── Base Master partagée (lecture : connectés ; écriture : admin) ─────────
    match /master/{doc} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // ── Annuaire utilisateurs : chacun écrit SA fiche ; lecture par connectés ─
    match /userDirectory/{uid} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && request.auth.uid == uid;
    }

    // ── Listes de courses partagées (autorisation par email) ─────────────────
    // L'email du token Google évite d'avoir à connaître l'UID des invités à
    // l'avance. Plafond métier « propriétaire + 3 invités » appliqué côté règles.
    match /sharedLists/{listId} {
      function isMember(rsc) {
        return hasVerifiedEmail() && email() in rsc.data.memberEmails;
      }

      // Membres (propriétaire + invités) : lecture & requêtes.
      allow read: if isMember(resource);

      // Création : seul le créateur, qui s'inclut comme propriétaire ET membre,
      // dans la limite de 4 membres (lui + 3).
      allow create: if hasVerifiedEmail()
                    && request.resource.data.ownerEmail == email()
                    && email() in request.resource.data.memberEmails
                    && request.resource.data.memberEmails.size() <= 4;

      // Mise à jour : tout membre courant édite (articles, nom, invités…), MAIS
      //   • le propriétaire est immuable (pas de transfert furtif),
      //   • il reste toujours membre,
      //   • le plafond de 4 membres tient.
      allow update: if isMember(resource)
                    && request.resource.data.ownerEmail == resource.data.ownerEmail
                    && resource.data.ownerEmail in request.resource.data.memberEmails
                    && request.resource.data.memberEmails.size() <= 4;

      // Suppression : réservée au propriétaire.
      allow delete: if hasVerifiedEmail()
                    && email() == resource.data.ownerEmail;
    }
  }
}
