rules_version = '2';

// Règles Firestore Cardamome.
// Convention : un bloc par collection, `allow` d'abord, commentaire bref au
// format « qui lit / qui écrit » + le POURQUOI seulement s'il n'est pas évident.
// Déploiement : `npx firebase deploy --only firestore:rules`

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() { return request.auth != null; }
    // Email vérifié requis : relève la barre face à un compte scriptable.
    function hasVerifiedEmail() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }
    function email() { return request.auth.token.email; }
    function isAdmin() {
      return hasVerifiedEmail() && email() == 'corentin.ducloux.edifice@gmail.com';
    }

    // Données privées : le propriétaire seul, lecture et écriture.
    match /users/{uid}/{document=**} {
      allow read, write: if isSignedIn() && request.auth.uid == uid;
    }

    // Abonnements Stripe : le client lit les siens ; écriture serveur (webhook
    // Admin SDK, qui contourne les règles). Aucun secret Stripe stocké ici.
    match /customers/{uid} {
      allow read: if isSignedIn() && request.auth.uid == uid;
      allow write: if false;
      match /subscriptions/{subId} {
        allow read: if isSignedIn() && request.auth.uid == uid;
        allow write: if false;
      }
    }

    // Mapping achat Play -> uid : serveur uniquement. Retrouve l'uid d'une
    // notification RTDN qui ne le porte pas ; aucun secret.
    match /playPurchases/{purchaseToken} {
      allow read, write: if false;
    }

    // Base Master : lecture par doc (`get`) pour tout compte vérifié, écriture
    // admin. Pas de `list` : la base d'ingrédients n'est pas énumérable en masse.
    match /master/{doc} {
      allow get: if hasVerifiedEmail();
      allow write: if isAdmin();
    }

    // Config d'admission (garde-fou anti-client périmé) : lecture par tout connecté
    // (le bootstrap la lit pour décider version/hôte), écriture admin seule.
    match /config/{doc} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Annuaire : chacun écrit SA fiche ; lecture par tout connecté (foyer/invits).
    match /userDirectory/{uid} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && request.auth.uid == uid;
    }

    // Foyers : membre (par uid) ou invité (par email). Création serveur only
    // (fonctionnalité Cardamome+, abonnement non vérifiable en règles). Plafond
    // de 2 places (membres + invitations) et owner immuable maintenus à l'update.
    match /households/{hid} {
      function isHMember(rsc) { return isSignedIn() && request.auth.uid in rsc.data.memberUids; }
      function isHInvited(rsc) { return hasVerifiedEmail() && email() in rsc.data.invitedEmails; }
      function peopleOk(d) { return d.memberUids.size() <= 2 && d.memberUids.size() + d.invitedEmails.size() <= 2; }

      allow read: if isHMember(resource) || isHInvited(resource);
      allow create: if false;
      allow update: if (isHMember(resource) || isHInvited(resource))
        && request.resource.data.ownerUid == resource.data.ownerUid
        && peopleOk(request.resource.data);
      allow delete: if isSignedIn() && request.auth.uid == resource.data.ownerUid;

      // Sous-collections (recettes, méta) : membres uniquement.
      match /{document=**} {
        allow read, write: if isSignedIn()
          && request.auth.uid in get(/databases/$(database)/documents/households/$(hid)).data.memberUids;
      }
    }

    // Recettes publiques : `get` public (partage par lien, rendu Open Graph par
    // des crawlers non authentifiés) ; `list` (Découverte) réservé aux comptes
    // vérifiés et borné à 120 contre l'aspiration. Écriture par l'auteur (uid ==
    // authorUid ET id préfixé `{uid}__`) ; suppression auteur ou admin (modération).
    match /publicRecipes/{pubId} {
      function ownsDoc() {
        return hasVerifiedEmail()
          && request.auth.uid == request.resource.data.authorUid
          && pubId.split('__')[0] == request.auth.uid;
      }
      allow get: if true;
      allow list: if hasVerifiedEmail() && request.query.limit <= 120;
      allow create, update: if ownsDoc();
      allow delete: if isAdmin()
        || (hasVerifiedEmail() && request.auth.uid == resource.data.authorUid);
    }

    // Signalements : création par le rapporteur (email vérifié) ; lecture et
    // traitement admin uniquement.
    match /reports/{id} {
      allow create: if hasVerifiedEmail()
        && request.resource.data.reporterUid == request.auth.uid;
      allow read, update, delete: if isAdmin();
    }

    // Quotas d'usage IA : le client lit les siens ; écriture serveur only
    // (transaction Admin SDK) pour interdire toute remise à zéro côté client.
    match /aiUsage/{uid} {
      allow read: if isSignedIn() && request.auth.uid == uid;
      allow write: if false;
    }

    // Cache d'idempotence des imports IA : serveur only. Renvoie le résultat
    // mémorisé sans re-débiter ni rappeler le LLM sur rejeu. Id : `{uid}__{requestId}`.
    match /importCache/{docId} {
      allow read, write: if false;
    }

    // Marques de facturation idempotente des imports IA : serveur only. Empêche
    // le re-débit d'un crédit sur rejeu. Id : `{uid}__{requestId}`.
    match /importCharge/{docId} {
      allow read, write: if false;
    }
  }
}
