{
  "$schema": "https://typedoc.org/schema.json",
  "name": "Cardamome : Bibliothèque métier (src/lib)",
  "entryPoints": ["src/lib"],
  "entryPointStrategy": "expand",
  "exclude": ["**/__tests__/**", "**/*.test.*"],
  "out": "docs/api",
  "tsconfig": "tsconfig.json",
  "readme": "docs/lib-overview.md",
  "customCss": "docs/typedoc.css",
  "includeVersion": true,
  "hideGenerator": true,
  "customFooterHtml": "<span>Cardamome · Bibliothèque métier (<code>src/lib</code>) · <a href=\"https://cardamome.studio\">cardamome.studio</a> · <a href=\"https://github.com/CDucloux/mijote\">Dépôt</a></span>",
  "excludePrivate": true,
  "excludeInternal": true,
  "validation": {
    "notExported": false,
    "invalidLink": true,
    "notDocumented": false
  },
  "categorizeByGroup": true,
  "navigation": {
    "includeCategories": false,
    "includeGroups": false,
    "includeFolders": true
  },
  "navigationLinks": {
    "Dépôt": "https://github.com/CDucloux/mijote"
  },
