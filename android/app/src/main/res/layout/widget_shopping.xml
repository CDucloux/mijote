<?xml version="1.0" encoding="utf-8"?>
<!-- Widget « Courses ». Textes d'exemple (apercu du selecteur) remplaces par ShoppingWidgetProvider. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingTop="14dp"
    android:paddingEnd="16dp"
    android:paddingBottom="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:baselineAligned="true"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:text="Courses"
            android:textColor="@color/widget_text"
            android:textSize="17sp"
            android:textStyle="bold" />

        <!-- Espaceur : RemoteViews refuse un View nu, d'ou un TextView vide. -->
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1" />

        <ImageView
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:background="@drawable/widget_chip"
            android:contentDescription="@null"
            android:padding="7dp"
            android:src="@drawable/ic_glyph_cart"
            android:tint="@color/widget_accent" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="4dp"
        android:baselineAligned="true"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/shop_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:fontFamily="sans-serif-medium"
            android:text="7"
            android:textColor="@color/widget_accent"
            android:textSize="30sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/shop_count_label"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="articles à acheter"
            android:textColor="@color/widget_text2"
            android:textSize="13sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/shop_row_0"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:baselineAligned="true"
        android:orientation="horizontal"
        android:paddingTop="6dp">

        <TextView
            android:id="@+id/shop_name_0"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Riz arborio"
            android:textColor="@color/widget_text"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/shop_qty_0"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:maxLines="1"
            android:text="300 g"
            android:textColor="@color/widget_text3"
            android:textSize="13sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/shop_row_1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:baselineAligned="true"
        android:orientation="horizontal"
        android:paddingTop="6dp">

        <TextView
            android:id="@+id/shop_name_1"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Cèpes"
            android:textColor="@color/widget_text"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/shop_qty_1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:maxLines="1"
            android:text="250 g"
            android:textColor="@color/widget_text3"
            android:textSize="13sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/shop_row_2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:baselineAligned="true"
        android:orientation="horizontal"
        android:paddingTop="6dp">

        <TextView
            android:id="@+id/shop_name_2"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Parmesan"
            android:textColor="@color/widget_text"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/shop_qty_2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:maxLines="1"
            android:text="80 g"
            android:textColor="@color/widget_text3"
            android:textSize="13sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/shop_row_3"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:baselineAligned="true"
        android:orientation="horizontal"
        android:paddingTop="6dp">

        <TextView
            android:id="@+id/shop_name_3"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Échalotes"
            android:textColor="@color/widget_text"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/shop_qty_3"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:maxLines="1"
            android:text="2"
            android:textColor="@color/widget_text3"
            android:textSize="13sp" />
    </LinearLayout>
</LinearLayout>
