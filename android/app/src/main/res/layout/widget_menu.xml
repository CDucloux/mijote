<?xml version="1.0" encoding="utf-8"?>
<!-- Widget « Au menu ». Les textes sont des exemples, servis aussi d'apercu dans le selecteur de widgets ; MenuWidgetProvider les remplace. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingTop="14dp"
    android:paddingEnd="16dp"
    android:paddingBottom="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:baselineAligned="true"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:text="Au menu"
            android:textColor="@color/widget_text"
            android:textSize="17sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/menu_date"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:maxLines="1"
            android:text="sam. 10 oct."
            android:textColor="@color/widget_text3"
            android:textSize="12sp" />

        <ImageView
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:background="@drawable/widget_chip"
            android:contentDescription="@null"
            android:padding="7dp"
            android:src="@drawable/ic_glyph_calendar"
            android:tint="@color/widget_accent" />
    </LinearLayout>

    <TextView
        android:id="@+id/menu_empty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="Rien de prévu. Touchez pour planifier."
        android:textColor="@color/widget_text2"
        android:textSize="14sp"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/menu_row_0"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:baselineAligned="true"
        android:orientation="horizontal"
        android:paddingTop="9dp"
        android:visibility="visible">

        <TextView
            android:id="@+id/menu_slot_0"
            android:layout_width="52dp"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:maxLines="1"
            android:text="Midi"
            android:textColor="#e0a23e"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/menu_title_0"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Salade de lentilles"
            android:textColor="@color/widget_text"
            android:textSize="15sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/menu_row_1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:baselineAligned="true"
        android:orientation="horizontal"
        android:paddingTop="9dp"
        android:visibility="visible">

        <TextView
            android:id="@+id/menu_slot_1"
            android:layout_width="52dp"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:maxLines="1"
            android:text="Soir"
            android:textColor="#c56b46"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/menu_title_1"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Risotto aux cèpes"
            android:textColor="@color/widget_text"
            android:textSize="15sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/menu_row_2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:baselineAligned="true"
        android:orientation="horizontal"
        android:paddingTop="9dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/menu_slot_2"
            android:layout_width="52dp"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:maxLines="1"
            android:text=""
            android:textColor="#c56b46"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/menu_title_2"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Tarte fine aux pommes"
            android:textColor="@color/widget_text"
            android:textSize="15sp" />
    </LinearLayout>
</LinearLayout>
