<?xml version="1.0" encoding="utf-8"?>
<!-- Couche avant de l'icone adaptative : gousse de cardamome blanche (reprise du
     favicon.svg), nervures dans le vert du fond pour l'effet « creux ». Coordonnees
     d'origine en 0..100 (favicon). Un seul groupe cale l'art au centre du canvas
     108x108 (translate 4,4 : centre 50 -> 54) et le reduit a 0.78 : les pointes
     de la gousse (a 35 du centre) tombent a ~27 du centre, bien dans la zone sure
     de l'icone adaptative (rayon ~33). A 0.9 la gousse paraissait surdimensionnee
     sur le lanceur ; 0.78 est l'entre-deux voulu avec l'icone PWA, plus menue. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <group
        android:pivotX="50"
        android:pivotY="50"
        android:scaleX="0.78"
        android:scaleY="0.78"
        android:translateX="4"
        android:translateY="4">
        <group android:rotation="45" android:pivotX="50" android:pivotY="50">
            <path
                android:fillColor="#FFFFFF"
                android:pathData="M50 15 C68 30 74 48 67 63 C62.5 74 55.5 80 50 85 C44.5 80 37.5 74 33 63 C26 48 32 30 50 15 Z" />
            <path
                android:strokeColor="#6E9A3F"
                android:strokeWidth="3.4"
                android:strokeLineCap="round"
                android:pathData="M50 24 C50 40 50 62 50 77" />
            <path
                android:strokeColor="#6E9A3F"
                android:strokeWidth="3"
                android:strokeLineCap="round"
                android:pathData="M42 30 C39.5 45 41 60 47 74" />
            <path
                android:strokeColor="#6E9A3F"
                android:strokeWidth="3"
                android:strokeLineCap="round"
                android:pathData="M58 30 C60.5 45 59 60 53 74" />
        </group>
    </group>
</vector>
